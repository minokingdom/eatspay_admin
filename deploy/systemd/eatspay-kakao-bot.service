[Unit]
Description=EatsPay dedicated Kakao bot
After=network-online.target iris-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=mino
WorkingDirectory=/home/mino/eatspay-kakao
EnvironmentFile=/home/mino/.bot_env
EnvironmentFile=-/home/mino/eatspay-kakao.env
ExecStart=/usr/bin/python3 -u /home/mino/eatspay-kakao/eatspay_kakao_bot.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
